# Python virtualenv
.venv/

# Ignore model weights / checkpoints (large binaries)
**/*.pt
**/*.pth
**/*.ckpt
**/*.onnx
**/*.pkl
**/*.npy
**/*.npz

# Common generated artifacts
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.Identifier

# Local outputs / caches
outputs/

# CUDA / Python build artifacts
brnfs/cuda_src/build/
brnfs/cuda_src/dist/
brnfs/cuda_src/*.egg-info/
brnfs/cuda_src/**/*.so
*.egg-info/
*.so

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
